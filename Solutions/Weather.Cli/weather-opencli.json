{
  "opencli": "0.1",
  "info": {
    "title": "Weather",
    "version": "1.0.0",
    "description": "Weather information and forecast CLI tool"
  },
  "commands": [
    {
      "name": "current",
      "description": "Get current weather for a city",
      "arguments": [
        {
          "name": "city",
          "description": "City name",
          "required": true
        }
      ],
      "options": [
        {
          "name": "unit",
          "aliases": ["u"],
          "description": "Temperature unit",
          "arguments": [
            {
              "name": "type",
              "required": true,
              "acceptedValues": ["celsius", "fahrenheit", "kelvin"]
            }
          ]
        },
        {
          "name": "detailed",
          "aliases": ["d"],
          "description": "Show detailed information"
        },
        {
          "name": "format",
          "aliases": ["f"],
          "description": "Output format",
          "arguments": [
            {
              "name": "type",
              "required": true,
              "acceptedValues": ["text", "json"]
            }
          ]
        }
      ],
      "examples": [
        "weather current London - Get current weather in London",
        "weather current Tokyo --unit fahrenheit - Get temperature in Fahrenheit",
        "weather current Paris --detailed - Get detailed weather information"
      ]
    },
    {
      "name": "forecast",
      "description": "Get weather forecast",
      "arguments": [
        {
          "name": "city",
          "description": "City name",
          "required": true
        }
      ],
      "options": [
        {
          "name": "days",
          "aliases": ["d"],
          "description": "Number of days (1-14)",
          "arguments": [
            {
              "name": "count",
              "required": true
            }
          ]
        },
        {
          "name": "unit",
          "aliases": ["u"],
          "description": "Temperature unit",
          "arguments": [
            {
              "name": "type",
              "required": true,
              "acceptedValues": ["celsius", "fahrenheit", "kelvin"]
            }
          ]
        },
        {
          "name": "format",
          "aliases": ["f"],
          "description": "Output format",
          "arguments": [
            {
              "name": "type",
              "required": true,
              "acceptedValues": ["table", "json", "chart"]
            }
          ]
        }
      ],
      "examples": [
        "weather forecast Paris - Get 5-day forecast for Paris",
        "weather forecast Berlin --days 7 - Get 7-day forecast",
        "weather forecast Madrid --format chart - Display forecast as a chart"
      ],
      "exitCodes": [
        {
          "code": 0,
          "description": "Success"
        },
        {
          "code": 1,
          "description": "Invalid parameters (e.g., days out of range)"
        }
      ]
    },
    {
      "name": "compare",
      "description": "Compare weather between cities",
      "arguments": [
        {
          "name": "cities",
          "description": "Cities to compare (2-5)",
          "required": true,
          "arity": { "minimum": 1 }
        }
      ],
      "options": [
        {
          "name": "unit",
          "aliases": ["u"],
          "description": "Temperature unit",
          "arguments": [
            {
              "name": "type",
              "required": true,
              "acceptedValues": ["celsius", "fahrenheit", "kelvin"]
            }
          ]
        }
      ],
      "examples": [
        "weather compare London Paris - Compare weather between two cities",
        "weather compare Tokyo \"New York\" Berlin - Compare weather between three cities"
      ],
      "exitCodes": [
        {
          "code": 0,
          "description": "Success"
        },
        {
          "code": 1,
          "description": "Invalid number of cities"
        }
      ]
    },
    {
      "name": "location",
      "description": "Manage saved locations",
      "commands": [
        {
          "name": "add",
          "description": "Add a favorite location",
          "arguments": [
            {
              "name": "city",
              "description": "City name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "nickname",
              "aliases": ["n"],
              "description": "Nickname for the location",
              "arguments": [
                {
                  "name": "name",
                  "required": true
                }
              ]
            }
          ],
          "examples": [
            "weather location add London - Add London to saved locations",
            "weather location add London --nickname home - Add London with a nickname"
          ]
        },
        {
          "name": "list",
          "description": "List saved locations",
          "examples": [
            "weather location list - Show all saved locations"
          ]
        },
        {
          "name": "remove",
          "description": "Remove a saved location",
          "arguments": [
            {
              "name": "city",
              "description": "City name to remove",
              "required": true
            }
          ],
          "options": [
            {
              "name": "force",
              "aliases": ["f"],
              "description": "Skip confirmation"
            }
          ],
          "examples": [
            "weather location remove London - Remove London from saved locations"
          ],
          "exitCodes": [
            {
              "code": 0,
              "description": "Location removed successfully"
            },
            {
              "code": 1,
              "description": "Location not found"
            }
          ]
        }
      ]
    }
  ]
}