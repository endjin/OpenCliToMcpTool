{
  "opencli": "0.1",
  "info": {
    "title": "Task Manager",
    "version": "1.0.0",
    "description": "A comprehensive task management CLI tool"
  },
  "options": [
    {
      "name": "verbose",
      "aliases": ["v"],
      "description": "Enable verbose output"
    },
    {
      "name": "config",
      "description": "Path to configuration file",
      "arguments": [
        {
          "name": "path",
          "required": true
        }
      ]
    }
  ],
  "commands": [
    {
      "name": "list",
      "description": "List all tasks",
      "aliases": ["ls"],
      "options": [
        {
          "name": "status",
          "aliases": ["s"],
          "description": "Filter by task status",
          "arguments": [
            {
              "name": "value",
              "required": true,
              "acceptedValues": ["pending", "in-progress", "completed", "cancelled"]
            }
          ]
        },
        {
          "name": "priority",
          "aliases": ["p"],
          "description": "Filter by priority",
          "arguments": [
            {
              "name": "value", 
              "required": true,
              "acceptedValues": ["low", "medium", "high", "critical"]
            }
          ]
        },
        {
          "name": "assignee",
          "aliases": ["a"],
          "description": "Filter by assignee",
          "arguments": [
            {
              "name": "name",
              "required": true
            }
          ]
        },
        {
          "name": "project",
          "description": "Filter by project",
          "arguments": [
            {
              "name": "name",
              "required": true
            }
          ]
        },
        {
          "name": "sort",
          "description": "Sort tasks by field",
          "arguments": [
            {
              "name": "field",
              "required": true,
              "acceptedValues": ["id", "title", "priority", "status", "due"]
            }
          ]
        },
        {
          "name": "show-completed",
          "description": "Show completed tasks"
        }
      ],
      "examples": [
        "taskmanager list - List all pending tasks",
        "taskmanager list --status pending - List only pending tasks",
        "taskmanager list --priority high --status in-progress - List high priority tasks that are in progress"
      ]
    },
    {
      "name": "task",
      "description": "Manage individual tasks",
      "commands": [
        {
          "name": "add",
          "description": "Add a new task",
          "arguments": [
            {
              "name": "title",
              "description": "Task title",
              "required": true
            }
          ],
          "options": [
            {
              "name": "description",
              "aliases": ["d"],
              "description": "Task description",
              "arguments": [
                {
                  "name": "text",
                  "required": true
                }
              ]
            },
            {
              "name": "priority",
              "aliases": ["p"],
              "description": "Task priority",
              "arguments": [
                {
                  "name": "level",
                  "required": true,
                  "acceptedValues": ["low", "medium", "high", "critical"]
                }
              ]
            },
            {
              "name": "due",
              "description": "Due date (YYYY-MM-DD or relative)",
              "arguments": [
                {
                  "name": "date",
                  "required": true
                }
              ]
            },
            {
              "name": "assignee",
              "aliases": ["a"],
              "description": "Assignee name",
              "arguments": [
                {
                  "name": "name",
                  "required": true
                }
              ]
            },
            {
              "name": "project",
              "description": "Project name",
              "arguments": [
                {
                  "name": "name",
                  "required": true
                }
              ]
            },
            {
              "name": "tags",
              "aliases": ["t"],
              "description": "Comma-separated tags",
              "arguments": [
                {
                  "name": "tags",
                  "required": true
                }
              ]
            }
          ],
          "examples": [
            "taskmanager task add \"Complete project documentation\" - Add a simple task",
            "taskmanager task add \"Review pull request\" --priority high --due tomorrow - Add a high priority task due tomorrow"
          ]
        },
        {
          "name": "update",
          "description": "Update an existing task",
          "arguments": [
            {
              "name": "id",
              "description": "Task ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "title",
              "description": "New title",
              "arguments": [
                {
                  "name": "text",
                  "required": true
                }
              ]
            },
            {
              "name": "description",
              "aliases": ["d"],
              "description": "New description",
              "arguments": [
                {
                  "name": "text",
                  "required": true
                }
              ]
            },
            {
              "name": "status",
              "aliases": ["s"],
              "description": "New status",
              "arguments": [
                {
                  "name": "value",
                  "required": true,
                  "acceptedValues": ["pending", "in-progress", "completed", "cancelled"]
                }
              ]
            },
            {
              "name": "priority",
              "aliases": ["p"],
              "description": "New priority",
              "arguments": [
                {
                  "name": "level",
                  "required": true,
                  "acceptedValues": ["low", "medium", "high", "critical"]
                }
              ]
            },
            {
              "name": "assignee",
              "aliases": ["a"],
              "description": "New assignee",
              "arguments": [
                {
                  "name": "name",
                  "required": true
                }
              ]
            },
            {
              "name": "clear-assignee",
              "description": "Clear assignee"
            }
          ],
          "examples": [
            "taskmanager task update 123 --status completed - Mark task as completed",
            "taskmanager task update 123 --priority low --assignee john - Update priority and assignee"
          ]
        },
        {
          "name": "delete",
          "description": "Delete a task",
          "aliases": ["rm"],
          "arguments": [
            {
              "name": "id",
              "description": "Task ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "force",
              "aliases": ["f"],
              "description": "Skip confirmation"
            }
          ],
          "examples": [
            "taskmanager task delete 123 - Delete task with confirmation",
            "taskmanager task delete 123 --force - Delete task without confirmation"
          ]
        },
        {
          "name": "show",
          "description": "Show details of a specific task",
          "arguments": [
            {
              "name": "id",
              "description": "Task ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "format",
              "aliases": ["f"],
              "description": "Output format",
              "arguments": [
                {
                  "name": "type",
                  "required": true,
                  "acceptedValues": ["table", "json"]
                }
              ]
            }
          ],
          "examples": [
            "taskmanager task show 123 - Show task details in table format",
            "taskmanager task show 123 --format json - Show task details in JSON format"
          ]
        }
      ]
    },
    {
      "name": "project",
      "description": "Manage projects",
      "commands": [
        {
          "name": "list",
          "description": "List all projects",
          "options": [
            {
              "name": "active",
              "description": "Show only active projects"
            }
          ],
          "examples": [
            "taskmanager project list - List all projects",
            "taskmanager project list --active - List only active projects"
          ]
        },
        {
          "name": "create",
          "description": "Create a new project",
          "arguments": [
            {
              "name": "name",
              "description": "Project name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "description",
              "aliases": ["d"],
              "description": "Project description",
              "arguments": [
                {
                  "name": "text",
                  "required": true
                }
              ]
            },
            {
              "name": "team",
              "aliases": ["t"],
              "description": "Team name",
              "arguments": [
                {
                  "name": "name",
                  "required": true
                }
              ]
            }
          ],
          "examples": [
            "taskmanager project create \"Website Redesign\" - Create a simple project",
            "taskmanager project create \"API Development\" --team backend - Create project with team assignment"
          ]
        },
        {
          "name": "archive",
          "description": "Archive a project",
          "arguments": [
            {
              "name": "name",
              "description": "Project name",
              "required": true
            }
          ],
          "examples": [
            "taskmanager project archive \"Old Project\" - Archive a project"
          ]
        }
      ]
    },
    {
      "name": "stats",
      "description": "Show task statistics",
      "options": [
        {
          "name": "period",
          "aliases": ["p"],
          "description": "Time period",
          "arguments": [
            {
              "name": "value",
              "required": true,
              "acceptedValues": ["today", "week", "month", "all"]
            }
          ]
        },
        {
          "name": "project",
          "description": "Filter by project",
          "arguments": [
            {
              "name": "name",
              "required": true
            }
          ]
        }
      ],
      "examples": [
        "taskmanager stats - Show all-time statistics",
        "taskmanager stats --period week - Show statistics for the past week",
        "taskmanager stats --period month --project \"Website Redesign\" - Show monthly statistics for a specific project"
      ]
    },
    {
      "name": "export",
      "description": "Export tasks to various formats",
      "arguments": [
        {
          "name": "output",
          "description": "Output file path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "format",
          "aliases": ["f"],
          "description": "Export format",
          "arguments": [
            {
              "name": "type",
              "required": true,
              "acceptedValues": ["json", "csv", "markdown"]
            }
          ]
        },
        {
          "name": "include-completed",
          "description": "Include completed tasks"
        },
        {
          "name": "project",
          "description": "Filter by project",
          "arguments": [
            {
              "name": "name",
              "required": true
            }
          ]
        }
      ],
      "examples": [
        "taskmanager export tasks.json - Export to JSON format",
        "taskmanager export tasks.csv --format csv - Export to CSV format",
        "taskmanager export report.md --format markdown --include-completed - Export to Markdown including completed tasks"
      ],
      "exitCodes": [
        {
          "code": 0,
          "description": "Export completed successfully"
        },
        {
          "code": 1,
          "description": "Export failed (e.g., invalid format, write error)"
        }
      ]
    }
  ]
}